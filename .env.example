# --- Fleet Management (required) -------------------------------------------
# Both values come from your Grafana Cloud stack:
# Connections > Collector > Fleet Management > API tab

# Fleet Management URL, no trailing slash,
# e.g. https://fleet-management-prod-008.grafana.net
GCLOUD_FM_URL=

# Instance ID shown under "API Authentication" on the same tab
GCLOUD_FM_INSTANCE_ID=

# Access policy token with the predefined scope `set:otel-data-write`
# (grants fleet-management:read + metrics/logs/traces/profiles:write).
# Create it under Administration > Users and access > Cloud access policies.
GCLOUD_RW_API_KEY=

# --- Grafana Cloud OTLP gateway (optional) ----------------------------------
# Only needed if you enable pipelines/cloud-export.yaml.
# From your stack: Connections > Add new connection > OpenTelemetry (OTLP)
# e.g. https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
GCLOUD_OTLP_ENDPOINT=
GCLOUD_OTLP_INSTANCE_ID=
